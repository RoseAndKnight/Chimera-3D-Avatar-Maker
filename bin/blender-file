#!/bin/bash
# Queue for Blender runs: as many slots as the machine can carry
# (one per physical core, 2.5 GB of free memory each, at least 2; BLENDER_PLACES, ATELIER_PLACES or calcul.places override it).
# Blender: programmes.blender from the settings (ATELIER_BLENDER), otherwise blender from the PATH; lock folder:
# calcul.file_attente, otherwise $TMPDIR/blender-file-<uid>. See outils/reglages.py.
# Usage: bin/blender-file <blender arguments>   (e.g. -b --python outils/base_libre/regarder.py -- <arguments>)
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
lire() { python3 -I "$R/outils/reglages.py" "$@" 2>/dev/null; }
B=$(lire programme blender); B=${B:-blender}
D=$(lire chemin calcul.file_attente); D=${D:-${TMPDIR:-/tmp}/blender-file-$(id -u)}
mkdir -p "$D"
N=${BLENDER_PLACES:-$(lire valeur calcul.places)}
if [ -z "$N" ]; then
  c=$(( $(nproc) / 2 )); m=$(( $(awk '/MemAvailable/ {print $2}' /proc/meminfo) / 2621440 ))
  N=$(( c < m ? c : m )); [ "$N" -lt 2 ] && N=2
fi
while true; do
  for i in $(seq 1 "$N"); do
    exec 9>"$D/place$i"
    if flock -n 9; then "$B" "$@"; exit $?; fi
    exec 9>&-
  done
  sleep 5
done
